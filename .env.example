# ─────────────────────────────────────────────────────────────────────────────
# EvidenceGuard – Environment Variables
# Copy this file to .env and fill in the values. Never commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# MongoDB connection string (required)
MONGODB_URI=

# Dedicated Test Database connection string (required for npm test)
# The test runner refuses to run against a database whose name does not contain
# "test" (e.g. mongodb://localhost:27017/evidenceguard_test) unless --force is passed.
TEST_MONGODB_URI=mongodb://localhost:27017/evidenceguard_test

# JWT signing secret – must be at least 32 random characters (required)
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Port the server listens on (default: 3000)
PORT=3000

# Node environment: development | production
NODE_ENV=development

# ─── Public URLs & CORS ───────────────────────────────────────────────────────

# Base URL used for QR codes and public verification links (no trailing slash)
# WARNING: When testing QR codes on mobile devices, replace localhost with your
# LAN IP (e.g. http://192.168.1.50:3000) or a tunnel URL (ngrok, etc.)
PUBLIC_BASE_URL=http://localhost:3000

# Optional: CORS allowed origin for the frontend. Leave blank for same-origin.
# Example: https://evidence.example.com
CLIENT_ORIGIN=

# ─── Storage ──────────────────────────────────────────────────────────────────

# Storage driver: 'local' (default) | future: 's3'
STORAGE_DRIVER=local

# Maximum allowed upload file size in megabytes (default: 50)
MAX_UPLOAD_MB=50

# ─── Bootstrap Admin Account ──────────────────────────────────────────────────
# Used by scripts/create-admin.js only. Not read at server startup.

ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@evidenceguard.local
ADMIN_PASSWORD=ChangeMe_Admin_2026!

# ─── Seed Admin (used by test scripts) ───────────────────────────────────────
# Override in test environment to match the account created by create-admin.js

SEED_ADMIN_EMAIL=admin@evidenceguard.local
SEED_ADMIN_PASSWORD=ChangeMe_Admin_2026!

# ─── Demo Seed Script (scripts/seed.js) ───────────────────────────────────────
# Optional password for demo users (demo.admin, demo.investigator, demo.viewer).
# If omitted, random 16-character passwords will be generated and printed once.
# SEED_DEMO_PASSWORD=OptionalDemoPassword123!

# ─── Feature Flags (Sprints 9-16) ──────────────────────────────────────────────
# Enable ECDSA P-256 digital signatures & officer key registration (Sprint 9)
FEATURE_SIGNATURES=false

# Enable Chain of Custody tracking & state machine (Sprint 12)
FEATURE_CUSTODY=false

# Enable Notification Pipeline & Outbox Worker (Sprint 13)
FEATURE_NOTIFICATIONS=false

# Enable Forensic Analysis & Metadata Extraction (Sprint 14)
FEATURE_FORENSICS=false

# Enable Remote Cloud Storage & Envelope Encryption (Sprint 11)
FEATURE_REMOTE_STORAGE=false
STORAGE_ENCRYPTION=false

# 32-byte base64 master key for wrapping data encryption keys (required if STORAGE_ENCRYPTION=true)
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
STORAGE_MASTER_KEY=

# S3 & MinIO Configuration (Sprint 11)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=evidenceguard-evidence
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ─── SMTP & Email Settings (Sprint 13) ─────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM="EvidenceGuard Security <notifications@evidenceguard.local>"

# ─── Sprint 16: KMS / HSM Configuration ────────────────────────────────────────
# Enable KMS/HSM key management feature
FEATURE_KMS=false

# KMS provider selection: 'local' (dev only) | 'pkcs11' (SoftHSM2 demo) | 'aws' (production)
# In production, KMS_PROVIDER=local is REFUSED unless ALLOW_LOCAL_KMS=true
KMS_PROVIDER=local

# Override: allow local software KMS in production (NOT SECURE - only for dev/staging)
ALLOW_LOCAL_KMS=false

# Enable KMS-backed JWT signing (ECDSA P-256 ES256 instead of HS256)
# Requires KMS_PROVIDER to be set to 'pkcs11' or 'aws'
JWT_USE_KMS=false

# Enable KMS-backed DEK wrapping for storage envelope encryption (Sprint 16B)
# Set to true to use KeyProvider.wrap() instead of direct STORAGE_MASTER_KEY
STORAGE_USE_KMS=false

# KMS operation timeout in milliseconds (default: 5000)
KMS_TIMEOUT_MS=5000

# ─── PKCS#11 / SoftHSM2 Provider (KMS_PROVIDER=pkcs11) ────────────────────────
# Path to the SoftHSM2 shared library
# Linux: /usr/lib/softhsm/libsofthsm2.so
# macOS: /usr/local/lib/softhsm/libsofthsm2.so
SOFTHSM_LIB=

# HSM token label (must match the token initialized with softhsm2-util)
SOFTHSM_TOKEN_LABEL=EvidenceGuardToken

# PKCS#11 slot ID (0-indexed)
SOFTHSM_SLOT=0

# HSM User PIN (sensitive — never commit to git)
SOFTHSM_PIN=

# Max PKCS#11 session pool size
KMS_POOL_SIZE=10

# ─── AWS KMS Provider (KMS_PROVIDER=aws) ─────────────────────────────────────
# AWS region where KMS keys are created
AWS_REGION=us-east-1

# AWS credentials (use IAM Instance Profile / Pod Identity in production instead)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Use mock AWS KMS (no real AWS calls, for local/CI testing only)
AWS_KMS_MOCK=true

# Storage KEK Key ID on PKCS11/AWS (default: STORAGE_KEK)
STORAGE_KEK_ID=STORAGE_KEK

# ─── PKCS#11 aliases (used by Pkcs11Provider, alternative to SOFTHSM_* vars) ──
PKCS11_LIB=
PKCS11_PIN=

# ─── Sprint 10: Ethereum Anchoring (FEATURE_ANCHORING) ──────────────────────────
# Ethereum private key for the ANCHORER_ROLE account (hex, 64 chars, no 0x prefix)
# WARNING: Never commit a funded mainnet key. Use a dedicated test account.
ANCHOR_PRIVATE_KEY=

# Blockchain RPC URLs
LOCAL_CHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_RPC_URL=http://127.0.0.1:8545
SEPOLIA_RPC_URL=

# Hardhat deployment helper keys (only needed when deploying the smart contract)
DEPLOYER_PRIVATE_KEY=
ETHERSCAN_API_KEY=

# AWS KMS alias for the Storage KEK (used by AwsKmsProvider when AWS is active)
AWS_KMS_KEY_STORAGE_KEK=

# ─── Test Script Variables (used by scripts/test-*.js only) ────────────────────
# Override the base URL for API tests (default: http://localhost:3000)
TEST_BASE_URL=http://localhost:3000

# Admin account used by test scripts (must match an account in the TEST database)
TEST_ADMIN_EMAIL=admin@evidenceguard.local
TEST_ADMIN_PASSWORD=

# Investigator account used by test scripts
TEST_INV_EMAIL=
TEST_INV_PASSWORD=