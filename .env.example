# ─────────────────────────────────────────────────────────────────────────────
# EvidenceGuard – Environment Variables
# Copy this file to .env and fill in the values. Never commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# MongoDB connection string (required)
MONGODB_URI=

# Dedicated Test Database connection string (required for npm test)
# The test runner refuses to run against a database whose name does not contain
# "test" (e.g. mongodb://localhost:27017/evidenceguard_test) unless --force is passed.
TEST_MONGODB_URI=mongodb://localhost:27017/evidenceguard_test

# JWT signing secret – must be at least 32 random characters (required)
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Port the server listens on (default: 3000)
PORT=3000

# Node environment: development | production
NODE_ENV=development

# ─── Public URLs & CORS ───────────────────────────────────────────────────────

# Base URL used for QR codes and public verification links (no trailing slash)
# WARNING: When testing QR codes on mobile devices, replace localhost with your
# LAN IP (e.g. http://192.168.1.50:3000) or a tunnel URL (ngrok, etc.)
PUBLIC_BASE_URL=http://localhost:3000

# Optional: CORS allowed origin for the frontend. Leave blank for same-origin.
# Example: https://evidence.example.com
CLIENT_ORIGIN=

# ─── Storage ──────────────────────────────────────────────────────────────────

# Storage driver: 'local' (default) | future: 's3'
STORAGE_DRIVER=local

# Maximum allowed upload file size in megabytes (default: 50)
MAX_UPLOAD_MB=50

# ─── Bootstrap Admin Account ──────────────────────────────────────────────────
# Used by scripts/create-admin.js only. Not read at server startup.

ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@evidenceguard.local
ADMIN_PASSWORD=ChangeMe_Admin_2026!

# ─── Seed Admin (used by test scripts) ───────────────────────────────────────
# Override in test environment to match the account created by create-admin.js

SEED_ADMIN_EMAIL=admin@evidenceguard.local
SEED_ADMIN_PASSWORD=ChangeMe_Admin_2026!

# ─── Demo Seed Script (scripts/seed.js) ───────────────────────────────────────
# Optional password for demo users (demo.admin, demo.investigator, demo.viewer).
# If omitted, random 16-character passwords will be generated and printed once.
# SEED_DEMO_PASSWORD=OptionalDemoPassword123!

# ─── Feature Flags (Sprints 9-16) ──────────────────────────────────────────────
# Enable ECDSA P-256 digital signatures & officer key registration (Sprint 9)
FEATURE_SIGNATURES=false

# Enable Chain of Custody tracking & state machine (Sprint 12)
FEATURE_CUSTODY=false

# Enable Notification Pipeline & Outbox Worker (Sprint 13)
FEATURE_NOTIFICATIONS=false

# Enable Forensic Analysis & Metadata Extraction (Sprint 14)
FEATURE_FORENSICS=false

# Enable Remote Cloud Storage & Envelope Encryption (Sprint 11)
FEATURE_REMOTE_STORAGE=false
STORAGE_ENCRYPTION=false

# 32-byte base64 master key for wrapping data encryption keys (required if STORAGE_ENCRYPTION=true)
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
STORAGE_MASTER_KEY=

# S3 & MinIO Configuration (Sprint 11)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=evidenceguard-evidence
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ─── SMTP & Email Settings (Sprint 13) ─────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM="EvidenceGuard Security <notifications@evidenceguard.local>"